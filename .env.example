# Environment
DATABASE_URL="postgresql://user:password@host:port/dbname"
DIRECT_URL="postgresql://user:password@host:port/dbname"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_here"

# Google Auth (for login)
GOOGLE_CLIENT_ID="your_google_id_here"
GOOGLE_CLIENT_SECRET="your_google_secret_here"

# Nano Banana API (for image/video logic)
MU_API_KEY="your_nano_banana_key_here"
# Optional platform provider. When set, chat uses an OpenAI-compatible chat/completions endpoint.
# Custom user keys still use MuAPI. Use HTTPS for remote endpoints.
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""
# Optional separate key (32+ chars); defaults to NEXTAUTH_SECRET. Keep it stable after saving user keys.
API_KEY_ENCRYPTION_KEY=""
# Creates a rolling summary after every ~10 older messages; uses extra provider calls.
AUTO_MEMORY_ENABLED="false"
# Voice chat: server-side keys, never expose with NEXT_PUBLIC_ prefixes.
GROQ_API_KEY=""
GROQ_STT_MODEL="whisper-large-v3-turbo"
GEMINI_API_KEY=""
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"
WEBHOOK_URL="your_webhook_url"

# Stripe (for payments)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Dynamic UI Theme Configuration
# Hosted Admins: Choose between: indigo, emerald, rose, amber, violet
NEXT_PUBLIC_THEME=rose
